{
  "name": "@ecropolis/emdash-theme-supper",
  "version": "0.1.0",
  "description": "A restaurant theme for EmDash: a structured menu with sections and dietary flags, hours, gallery, reviews, and reservation CTAs",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "astro-template",
    "emdash",
    "emdash-theme",
    "restaurant",
    "cafe",
    "bar",
    "menu",
    "reservations"
  ],
  "emdash": {
    "label": "Supper",
    "description": "For restaurants, cafes, and bars: a structured menu with sections, prices and dietary flags, plus hours, gallery, and reservation CTAs",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check",
    "deploy:demo": "DEMO_ATTRIBUTION=1 astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "@astrojs/react": "^6.0.0",
    "@ecropolis/emdash-plugin-compass-mail": "^0.1.0",
    "@emdash-cms/cloudflare": "^0.30.0",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.0.0",
    "astro-iconset": "^0.0.4",
    "emdash": "^0.30.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@cloudflare/workers-types": "^4.20260305.1",
    "wrangler": "^4.99.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecropolis/emdash-theme-supper.git"
  },
  "homepage": "https://github.com/ecropolis/emdash-theme-supper#readme"
}
